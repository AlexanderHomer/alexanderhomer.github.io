# Copy this file to .env and fill in real values. Never commit .env.

# Create a Slack app at https://api.slack.com/apps, install it to your
# workspace, and grant it these Bot Token scopes:
#   channels:history  channels:read  users:read  groups:history  groups:read
# Then invite the bot to whichever channels you want polled.
SLACK_BOT_TOKEN=xoxb-your-token-here

# Comma-separated Slack channel IDs to poll (not channel names).
# Find a channel's ID in Slack: right-click the channel -> View channel details.
SLACK_CHANNELS=C0123456789,C0987654321

# Optional overrides
PORT=4173
SLACK_POLL_MS=15000
